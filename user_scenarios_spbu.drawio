<mxfile host="app.diagrams.net" agent="Antigravity" version="21.0.0" type="device">
  <diagram id="spbu-user-scenarios" name="User Scenarios SPBU Logistics">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1120" background="#08090b" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- HEADER BANNER -->
        <mxCell id="header" value="&lt;b style=&quot;font-size: 20px; color: #10b981;&quot;&gt;USER SCENARIOS &amp; WORKFLOW SISTEM&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px; color: #94a3b8;&quot;&gt;Sistem Pemantauan Logistik Distribusi BBM &amp;amp; Portal Layanan Warga (spbu.hub)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0e1117;strokeColor=#10b981;strokeWidth=1.5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1600" height="70" as="geometry" />
        </mxCell>

        <!-- SWIMLANE 1: ADMIN LOGISTIK PUSAT -->
        <mxCell id="lane_admin" value="&lt;b style=&quot;font-size: 16px; color: #38bdf8;&quot;&gt;ACTOR 1: ADMIN LOGISTIK PUSAT (DISPATCHER)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #64748b;&quot;&gt;Fokus: Supply Chain, Monitoring GPS Armada Truk Tangki, Restock BBM &amp;amp; Verifikasi Laporan&lt;/span&gt;" style="swimlane;html=1;startSize=50;fillColor=#0c0e12;strokeColor=#0284c7;strokeWidth=2;rounded=1;fontColor=#ffffff;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="780" height="960" as="geometry" />
        </mxCell>

        <!-- SWIMLANE 2: PORTAL WARGA / PENGENDARA -->
        <mxCell id="lane_warga" value="&lt;b style=&quot;font-size: 16px; color: #34d399;&quot;&gt;ACTOR 2: WARGA / PENGENDARA (CITIZEN PORTAL)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #64748b;&quot;&gt;Fokus: Cek Stok BBM Terdekat, Pantau Antrean SPBU, Navigasi Rute &amp;amp; Pengaduan Publik&lt;/span&gt;" style="swimlane;html=1;startSize=50;fillColor=#0c0e12;strokeColor=#10b981;strokeWidth=2;rounded=1;fontColor=#ffffff;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="860" y="110" width="780" height="960" as="geometry" />
        </mxCell>

        <!-- ==================== ADMIN NODES ==================== -->
        
        <!-- Node A1 -->
        <mxCell id="A1" value="&lt;b style=&quot;color: #ffffff;&quot;&gt;1. Login Admin Pusat&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #94a3b8;&quot;&gt;Akses portal via email &amp;amp; password resmi dispatcher&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13161c;strokeColor=#38bdf8;strokeWidth=1.5;fontColor=#ffffff;" vertex="1" parent="lane_admin">
          <mxGeometry x="40" y="80" width="310" height="65" as="geometry" />
        </mxCell>

        <!-- Node A2 -->
        <mxCell id="A2" value="&lt;b style=&quot;color: #ffffff;&quot;&gt;2. Dashboard Bento Overview&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #94a3b8;&quot;&gt;Cek gauge 'Logistics Health', insight AI &amp;amp; ringkasan tangki SPBU&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13161c;strokeColor=#0284c7;strokeWidth=1.5;fontColor=#ffffff;" vertex="1" parent="lane_admin">
          <mxGeometry x="420" y="80" width="310" height="65" as="geometry" />
        </mxCell>

        <!-- Node A3 -->
        <mxCell id="A3" value="&lt;b style=&quot;color: #ffffff;&quot;&gt;3. Skenario 1.1: Pemantauan GPS Truk&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #94a3b8;&quot;&gt;Filter peta 'TRUK', pantau koordinat armada, volume muatan &amp;amp; ETA&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;strokeWidth=1.5;fontColor=#ffffff;" vertex="1" parent="lane_admin">
          <mxGeometry x="420" y="190" width="310" height="70" as="geometry" />
        </mxCell>

        <!-- Node A4 -->
        <mxCell id="A4" value="&lt;b style=&quot;color: #f59e0b;&quot;&gt;4. Deteksi Tangki SPBU Menipis (&amp;lt;30%)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #94a3b8;&quot;&gt;Sistem tandai tangki kritis (misal: Solar SPBU Gatot Subroto)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13161c;strokeColor=#f59e0b;strokeWidth=1.5;fontColor=#ffffff;" vertex="1" parent="lane_admin">
          <mxGeometry x="40" y="310" width="310" height="65" as="geometry" />
        </mxCell>

        <!-- Node A5 -->
        <mxCell id="A5" value="&lt;b style=&quot;color: #ffffff;&quot;&gt;5. Skenario 1.2: Jadwalkan Pengiriman&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #94a3b8;&quot;&gt;Klik '+ Jadwalkan', pilih SPBU, jenis BBM, armada truk, sopir &amp;amp; volume&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13161c;strokeColor=#0284c7;strokeWidth=1.5;fontColor=#ffffff;" vertex="1" parent="lane_admin">
          <mxGeometry x="420" y="310" width="310" height="70" as="geometry" />
        </mxCell>

        <!-- Node A6 -->
        <mxCell id="A6" value="&lt;b style=&quot;color: #ffffff;&quot;&gt;6. Truk Berangkat &amp;amp; Bergerak (In Transit)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #94a3b8;&quot;&gt;Simulasi GPS menggerakkan marker truk dari TBBM menuju SPBU&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13161c;strokeColor=#38bdf8;strokeWidth=1.5;fontColor=#ffffff;" vertex="1" parent="lane_admin">
          <mxGeometry x="420" y="430" width="310" height="65" as="geometry" />
        </mxCell>

        <!-- Node A7 -->
        <mxCell id="A7" value="&lt;b style=&quot;color: #10b981;&quot;&gt;7. Truk Tiba &amp;amp; Auto-Restock Tangki&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #94a3b8;&quot;&gt;Status berubah 'Selesai', volume tangki SPBU otomatis bertambah&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#10b981;strokeWidth=2;fontColor=#ffffff;" vertex="1" parent="lane_admin">
          <mxGeometry x="420" y="550" width="310" height="70" as="geometry" />
        </mxCell>

        <!-- Node A8 -->
        <mxCell id="A8" value="&lt;b style=&quot;color: #ffffff;&quot;&gt;8. Skenario 1.3: Review Laporan Warga&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #94a3b8;&quot;&gt;Tab Laporan: periksa tiket keluhan antrean / BBM habis + foto bukti&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13161c;strokeColor=#f43f5e;strokeWidth=1.5;fontColor=#ffffff;" vertex="1" parent="lane_admin">
          <mxGeometry x="40" y="700" width="310" height="70" as="geometry" />
        </mxCell>

        <!-- Node A9 -->
        <mxCell id="A9" value="&lt;b style=&quot;color: #ffffff;&quot;&gt;9. Tindak Lanjut &amp;amp; Feedback Petugas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #94a3b8;&quot;&gt;Ubah status ke 'Ditindaklanjuti/Selesai' &amp;amp; beri catatan resmi admin&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13161c;strokeColor=#10b981;strokeWidth=1.5;fontColor=#ffffff;" vertex="1" parent="lane_admin">
          <mxGeometry x="420" y="700" width="310" height="70" as="geometry" />
        </mxCell>

        <!-- ==================== WARGA NODES ==================== -->

        <!-- Node W1 -->
        <mxCell id="W1" value="&lt;b style=&quot;color: #ffffff;&quot;&gt;1. Buka Portal Mobile (/warga)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #94a3b8;&quot;&gt;Warga membuka antarmuka mobile dari smartphone / browser&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13161c;strokeColor=#34d399;strokeWidth=1.5;fontColor=#ffffff;" vertex="1" parent="lane_warga">
          <mxGeometry x="40" y="80" width="310" height="65" as="geometry" />
        </mxCell>

        <!-- Node W2 -->
        <mxCell id="W2" value="&lt;b style=&quot;color: #ffffff;&quot;&gt;2. Skenario 2.1: Filter BBM &amp;amp; Cari SPBU&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #94a3b8;&quot;&gt;Aktifkan filter 'Pertalite Ready', 'Antrean Lancar', atau input nama jalan&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#10b981;strokeWidth=1.5;fontColor=#ffffff;" vertex="1" parent="lane_warga">
          <mxGeometry x="420" y="80" width="310" height="65" as="geometry" />
        </mxCell>

        <!-- Node W3 -->
        <mxCell id="W3" value="&lt;b style=&quot;color: #ffffff;&quot;&gt;3. Pilih Pin SPBU &amp;amp; Cek Bottom Card&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #94a3b8;&quot;&gt;Peta tampilkan jarak (0.8 km), status buka, antrean (~5 mnt) &amp;amp; stok&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13161c;strokeColor=#34d399;strokeWidth=1.5;fontColor=#ffffff;" vertex="1" parent="lane_warga">
          <mxGeometry x="420" y="190" width="310" height="70" as="geometry" />
        </mxCell>

        <!-- Node W4 -->
        <mxCell id="W4" value="&lt;b style=&quot;color: #ffffff;&quot;&gt;4. Skenario 2.2: Rute Google Maps&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #94a3b8;&quot;&gt;Klik 'Buka Arah Rute', aplikasi navigasi memandu rute langsung ke SPBU&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13161c;strokeColor=#0284c7;strokeWidth=1.5;fontColor=#ffffff;" vertex="1" parent="lane_warga">
          <mxGeometry x="420" y="310" width="310" height="65" as="geometry" />
        </mxCell>

        <!-- Node W5 -->
        <mxCell id="W5" value="&lt;b style=&quot;color: #ffffff;&quot;&gt;5. Warga Mengisi BBM di Lokasi&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #94a3b8;&quot;&gt;Pengendara mengisi bensin sesuai ketersediaan bahan bakar&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13161c;strokeColor=#34d399;strokeWidth=1.5;fontColor=#ffffff;" vertex="1" parent="lane_warga">
          <mxGeometry x="420" y="420" width="310" height="65" as="geometry" />
        </mxCell>

        <!-- Node W6 (Decision) -->
        <mxCell id="W6" value="&lt;b style=&quot;color: #ffffff;&quot;&gt;Apakah Ada Kendala?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #94a3b8;&quot;&gt;Antrean macet / BBM habis / fasilitas rusak?&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#f59e0b;strokeWidth=1.5;fontColor=#ffffff;" vertex="1" parent="lane_warga">
          <mxGeometry x="455" y="520" width="240" height="90" as="geometry" />
        </mxCell>

        <!-- Node W7 -->
        <mxCell id="W7" value="&lt;b style=&quot;color: #10b981;&quot;&gt;Selesai (Aman)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #94a3b8;&quot;&gt;Transaksi sukses tanpa kendala&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#10b981;strokeWidth=1.5;fontColor=#ffffff;" vertex="1" parent="lane_warga">
          <mxGeometry x="40" y="535" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- Node W8 -->
        <mxCell id="W8" value="&lt;b style=&quot;color: #ffffff;&quot;&gt;6. Skenario 2.3: Kirim Laporan Warga&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #94a3b8;&quot;&gt;Buka tab 'Lapor', pilih SPBU, kategori masalah, isi deskripsi + foto&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13161c;strokeColor=#f43f5e;strokeWidth=1.5;fontColor=#ffffff;" vertex="1" parent="lane_warga">
          <mxGeometry x="420" y="660" width="310" height="70" as="geometry" />
        </mxCell>

        <!-- Node W9 -->
        <mxCell id="W9" value="&lt;b style=&quot;color: #ffffff;&quot;&gt;7. Pantau Progres di Tab 'Aktivitas'&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #94a3b8;&quot;&gt;Live Stepper: Menunggu → Diverifikasi → Ditindaklanjuti → Selesai&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13161c;strokeColor=#34d399;strokeWidth=1.5;fontColor=#ffffff;" vertex="1" parent="lane_warga">
          <mxGeometry x="420" y="780" width="310" height="70" as="geometry" />
        </mxCell>

        <!-- ==================== CONNECTORS ==================== -->

        <!-- Admin internal flow -->
        <mxCell id="c_a1_a2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#38bdf8;strokeWidth=2;html=1;" edge="1" parent="lane_admin" source="A1" target="A2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_a2_a3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#38bdf8;strokeWidth=2;html=1;" edge="1" parent="lane_admin" source="A2" target="A3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_a2_a4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#f59e0b;strokeWidth=2;html=1;" edge="1" parent="lane_admin" source="A2" target="A4">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="575" y="170" />
              <mxPoint x="195" y="170" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c_a4_a5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#f59e0b;strokeWidth=2;html=1;" edge="1" parent="lane_admin" source="A4" target="A5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_a5_a6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#38bdf8;strokeWidth=2;html=1;" edge="1" parent="lane_admin" source="A5" target="A6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_a6_a7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#10b981;strokeWidth=2;html=1;" edge="1" parent="lane_admin" source="A6" target="A7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_a8_a9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#10b981;strokeWidth=2;html=1;" edge="1" parent="lane_admin" source="A8" target="A9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Warga internal flow -->
        <mxCell id="c_w1_w2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#34d399;strokeWidth=2;html=1;" edge="1" parent="lane_warga" source="W1" target="W2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_w2_w3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#34d399;strokeWidth=2;html=1;" edge="1" parent="lane_warga" source="W2" target="W3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_w3_w4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#34d399;strokeWidth=2;html=1;" edge="1" parent="lane_warga" source="W3" target="W4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_w4_w5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#34d399;strokeWidth=2;html=1;" edge="1" parent="lane_warga" source="W4" target="W5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_w5_w6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#f59e0b;strokeWidth=2;html=1;" edge="1" parent="lane_warga" source="W5" target="W6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_w6_w7" value="Tidak" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#10b981;strokeWidth=2;fontColor=#10b981;html=1;" edge="1" parent="lane_warga" source="W6" target="W7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_w6_w8" value="Ya (Ada Masalah)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#f43f5e;strokeWidth=2;fontColor=#f43f5e;html=1;" edge="1" parent="lane_warga" source="W6" target="W8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_w8_w9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#34d399;strokeWidth=2;html=1;" edge="1" parent="lane_warga" source="W8" target="W9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== CROSS-LANE CONNECTORS ==================== -->
        
        <!-- Restock updates Warga's fuel availability -->
        <mxCell id="cross_restock" value="&lt;b style=&quot;color: #10b981;&quot;&gt;Auto-Sync Stok BBM&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#10b981;strokeWidth=2.5;dashed=1;fontColor=#10b981;html=1;" edge="1" parent="1" source="A7" target="W2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="800" y="695" />
              <mxPoint x="800" y="222" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Warga report arrives at Admin review -->
        <mxCell id="cross_report" value="&lt;b style=&quot;color: #f43f5e;&quot;&gt;Tiket Laporan Masuk&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#f43f5e;strokeWidth=2.5;dashed=1;fontColor=#f43f5e;html=1;" edge="1" parent="1" source="W8" target="A8">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1280" y="860" />
              <mxPoint x="235" y="860" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Admin feedback syncs to Warga tracking stepper -->
        <mxCell id="cross_feedback" value="&lt;b style=&quot;color: #38bdf8;&quot;&gt;Update Status &amp;amp; Catatan Petugas&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#38bdf8;strokeWidth=2.5;dashed=1;fontColor=#38bdf8;html=1;" edge="1" parent="1" source="A9" target="W9">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="615" y="920" />
              <mxPoint x="1435" y="920" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
